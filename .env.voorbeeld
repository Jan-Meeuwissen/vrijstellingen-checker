# Kopieer dit bestand naar `.env` en vul de echte waarden in. `.env` staat
# in .gitignore en wordt dus nooit meegecommit.

# SSH-gebruiker op de server
DEPLOY_USER=

# Hostnaam van de server
DEPLOY_HOST=faistos.nl

# SSH-poort (leeg laten voor de standaardpoort 22)
DEPLOY_PORT=

# Pad naar de SSH-sleutel, indien nodig (leeg laten om de standaardsleutel
# van je ssh-agent te gebruiken)
DEPLOY_SSH_KEY=

# Absoluut pad op de server naar de map die als https://faistos.nl/vrijstelling
# wordt uitgeserveerd (de docroot van www.faistos.nl, plus /vrijstelling)
DEPLOY_PAD=
